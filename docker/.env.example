# ---- Model (same names as in shmoker-ai, EXTENDED_REPORT_AI_* take precedence) ----
# openai | proxy | gigachat | gigacode-ift-ssl | gigacode-cli
EXTENDED_REPORT_AI_PROVIDER=gigachat
EXTENDED_REPORT_AI_MODEL=GigaChat-Pro
EXTENDED_REPORT_AI_LANGUAGE=Russian

# GigaChat
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_VERIFY_SSL=false

# Proxy LLM / OpenAI-compatible
# EXTENDED_REPORT_AI_PROVIDER=proxy
# PROXY_BASE_URL=http://llm.internal:8080/v1
# PROXY_API_KEY=none

# GigaCode IFT SSL (mount the certificates into the container)
# EXTENDED_REPORT_AI_PROVIDER=gigacode-ift-ssl
# EXTENDED_REPORT_AI_BASE_URL=https://ift-gateway/v1
# EXTENDED_REPORT_AI_CERT=/certs/client.pem
# EXTENDED_REPORT_AI_KEY=/certs/client.key

# ---- Agent ----
EXTENDED_REPORT_AI_MAX_CHARS=40000
# Only the Jenkins origin may call the agent from the browser:
EXTENDED_REPORT_AI_CORS_ORIGIN=*
# Allow re-runs and fixes in /workspace (off by default; the Jenkins VM is usually analysis only)
AGENT_ALLOW_RUN=0
