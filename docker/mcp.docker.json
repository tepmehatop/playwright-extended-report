{
  "mcpServers": {
    "playwright": {
      "command": "playwright-mcp",
      "args": ["--headless", "--isolated", "--no-sandbox", "--browser", "chromium"]
    },
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server", "--project", "${REPO}", "--context", "ide-assistant", "--enable-web-dashboard", "false"],
      "disabled": true
    },
    "code-index": {
      "command": "code-index-mcp",
      "args": ["--project-path", "${REPO}"],
      "disabled": true
    },
    "context7": {
      "command": "context7-mcp",
      "disabled": true
    },
    "codebase-memory": {
      "command": "/opt/mcp/codebase-memory-mcp",
      "disabled": true
    }
  }
}
