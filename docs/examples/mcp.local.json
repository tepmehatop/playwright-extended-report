{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--project", "${REPO}", "--context", "ide-assistant", "--enable-web-dashboard", "false"],
      "timeout": 240
    },
    "code-index": {
      "command": "uvx",
      "args": ["code-index-mcp", "--project-path", "${REPO}"]
    },
    "codebase-memory": {
      "command": "codebase-memory-mcp"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated", "--browser", "chromium"]
    }
  }
}
